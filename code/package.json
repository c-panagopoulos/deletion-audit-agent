{
  "name": "ghost-data-deletion-audit",
  "version": "1.0.0",
  "description": "Deletion-audit agent for HackerRank Orchestrate: Ghost Data Still Exists",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "audit": "node --no-warnings main.js",
    "eval": "node --no-warnings evaluation/eval.js",
